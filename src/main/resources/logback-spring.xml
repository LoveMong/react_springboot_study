<configuration>
    <!-- 1. 스프링 프로파일을 사용한 환경별 로깅 -->
    <springProfile name="default">
        <property name="LOG_PATH" value="./logs" /> <!-- 로그 파일 경로 -->
    </springProfile>
    <springProfile name="dev">
        <property name="LOG_PATH" value="./logs/dev" />
    </springProfile>

    <!-- 2. 콘솔 로그 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. 파일 로그 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file> <!-- 로그 파일 이름 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application-%d{yyyy-MM-dd}.log</fileNamePattern> <!-- 일자별 로그 파일 -->
            <maxHistory>5</maxHistory> <!-- 로그 파일 보관 일수 -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 4. 오류 로그 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file> <!-- 오류 로그 파일 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>5</maxHistory>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level> <!-- 오류 로그만 추가 -->
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 5. 루트 로거 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" /> <!-- 콘솔 로그 -->
        <appender-ref ref="FILE" /> <!-- 파일 로그 -->
        <appender-ref ref="ERROR_FILE" /> <!-- 오류 로그 -->
    </root>

    <!-- 6. 원하는 패키지별 로깅 레벨 조정 -->
    <logger name="com.jy.study" level="DEBUG" /> <!-- DEBUG 레벨 적용 -->
</configuration>